# FROM mcr.microsoft.com/dotnet/sdk:10.0 AS builder

# WORKDIR /src

# # Copy solution and project files
# COPY . .

# # Restore, build and publish
# # Note: using SDK 8.0 in container to avoid QEMU-related crashes on arm64 hosts
# # Remove global.json temporarily so SDK 8.0 is used (local dev keeps global.json with 10.0)
# # RUN rm global.json
# RUN dotnet publish SportFriends.slnx -c Release -o /app/publish

# # Runtime image
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble

WORKDIR /app

COPY ./publish .
# Copy published application from builder
# COPY --from=builder /app/publish .

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f https://localhost:5000/health || exit 1

ENTRYPOINT ["dotnet", "SportFriends.API.dll"]
